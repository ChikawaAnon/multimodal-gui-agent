# ===== 眼睛：现成多模态视觉 API（Kimi / Moonshot）=====
KIMI_API_KEY=sk-请填你的key
KIMI_VISION_MODEL=kimi-k2.6

# ===== 大脑：DeepSeek（OpenAI 兼容接口；默认走本机 cc-switch 代理）=====
DEEPSEEK_BASE_URL=http://127.0.0.1:15721/v1
DEEPSEEK_API_KEY=PROXY_MANAGED
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 手：浏览器 =====  
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# ===== Demo 任务 =====  
TASK=在页面上找到登录表单：输入用户名 demo、密码 123456，点击登录按钮，最后确认页面出现欢迎文字
MAX_STEPS=10